# Aura Partner Research — Environment Configuration Template
# Copy this file to .env and insert your API credentials.

# Google Gemini API Key (Required for AI synthesis, ICP refinement, and Google Search Grounding)
# Obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Port configuration (defaults to 8000 for FastAPI, 5173 for Vite)
PORT=8000
VITE_PORT=5173
